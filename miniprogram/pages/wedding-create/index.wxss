page {
  background: #fff;
}

.create-container {
  padding-bottom: 30rpx;
}

.top-image-wrap {
  display: flex;
  justify-content: center;
}

.top-image {
  width: 300rpx;
  height: 300rpx;
}

.form-container {
  padding: 0 40rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #FF85A1;
}

.optional {
  color: #999;
  font-size: 24rpx;
  font-weight: normal;
}

.form-input-wrap {
  display: flex;
  align-items: center;
  height: 96rpx;
  border: 2rpx solid #F5F5F5;
  border-radius: 24rpx;
  padding: 0 24rpx;
  background: #FFF;
}

.input-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.input-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.placeholder {
  color: #CCC;
}

.unit-text {
  font-size: 28rpx;
  color: #666;
  margin-left: 16rpx;
}

.tip-wrap {
  margin: 0 40rpx 60rpx;
  background: #FFF0F4;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.tip-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.tip-highlight {
  color: #FF85A1;
  font-weight: bold;
}

.footer-buttons {
  padding: 0 40rpx;
}

.btn-create {
  background: #FF85A1;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border-radius: 24rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}

.btn-back {
  background: #F5F5F5;
  color: #666;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border-radius: 24rpx;
  padding: 28rpx 0;
}