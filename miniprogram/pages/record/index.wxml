<view class="page-container">
  <!-- Header Title -->
  <view class="header-title">费用账本</view>
  <!-- Top Tabs -->
  <view class="tab-container">
    <view class="tab-item active">全部</view>
    <view class="tab-item">已付</view>
    <view class="tab-item">未付</view>
  </view>
  <!-- Summary Card -->
  <view class="summary-card">
    <view class="summary-item">
      <text class="summary-label">总支出</text>
      <text class="summary-value dark">¥128,000.00</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <text class="summary-label">已付</text>
      <text class="summary-value dark">¥78,000.00</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <text class="summary-label">未付</text>
      <text class="summary-value pink">¥50,000.00</text>
    </view>
  </view>
  <!-- List Content -->
  <view class="list-container">
    <!-- Category Card 1 -->
    <view class="category-card">
      <view class="category-header">
        <view class="category-left">
          <view class="icon-wrap pink">
            <text>📷</text>
          </view>
          <text class="category-title">婚纱摄影</text>
        </view>
        <view class="category-right">
          <text class="category-count">共 1 项</text>
          <text class="category-total">¥5,000.00</text>
          <text class="arrow-up">v</text>
        </view>
      </view>
      <view class="item-list">
        <view class="record-item">
          <view class="item-info">
            <view class="item-name">婚纱摄影定金</view>
            <view class="item-desc">2小时前 · 负责人: 晓敏</view>
          </view>
          <view class="item-amount-wrap">
            <text class="item-amount">¥5,000.00</text>
            <text class="status-tag paid">已付</text>
          </view>
        </view>
      </view>
    </view>
    <!-- Category Card 2 -->
    <view class="category-card">
      <view class="category-header">
        <view class="category-left">
          <view class="icon-wrap pink">
            <text>🏨</text>
          </view>
          <text class="category-title">婚宴酒店</text>
        </view>
        <view class="category-right">
          <text class="category-count">共 2 项</text>
          <text class="category-total">¥68,000.00</text>
          <text class="arrow-up">v</text>
        </view>
      </view>
      <view class="item-list">
        <view class="record-item border-bottom">
          <view class="item-info">
            <view class="item-name">婚宴酒店预订金</view>
            <view class="item-desc">昨天 · 负责人: 志强</view>
          </view>
          <view class="item-amount-wrap">
            <text class="item-amount">¥20,000.00</text>
            <text class="status-tag paid">已付</text>
          </view>
        </view>
        <view class="record-item">
          <view class="item-info">
            <view class="item-name">婚宴酒店尾款</view>
            <view class="item-desc">2025-11-30 · 负责人: 志强</view>
          </view>
          <view class="item-amount-wrap">
            <text class="item-amount">¥48,000.00</text>
            <text class="status-tag unpaid">未付</text>
          </view>
        </view>
      </view>
    </view>
    <!-- Category Card 3 -->
    <view class="category-card">
      <view class="category-header">
        <view class="category-left">
          <view class="icon-wrap pink">
            <text>❤️</text>
          </view>
          <text class="category-title">婚礼策划</text>
        </view>
        <view class="category-right">
          <text class="category-count">共 2 项</text>
          <text class="category-total">¥18,000.00</text>
          <text class="arrow-up">v</text>
        </view>
      </view>
      <view class="item-list">
        <view class="record-item border-bottom">
          <view class="item-info">
            <view class="item-name">婚礼策划服务费</view>
            <view class="item-desc">3天前 · 负责人: 晓敏</view>
          </view>
          <view class="item-amount-wrap">
            <text class="item-amount">¥10,000.00</text>
            <text class="status-tag paid">已付</text>
          </view>
        </view>
        <view class="record-item">
          <view class="item-info">
            <view class="item-name">婚礼现场布置</view>
            <view class="item-desc">2025-11-15 · 负责人: 晓敏</view>
          </view>
          <view class="item-amount-wrap">
            <text class="item-amount">¥8,000.00</text>
            <text class="status-tag unpaid">未付</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <!-- Floating Add Button -->
  <view class="fab-btn" bindtap="onAddRecord">
    <view class="fab-icon">+</view>
  </view>
</view>