.mine-container {
  padding: 30rpx;
  box-sizing: border-box;
  height: 100vh;
  background-color: #fff;
}

.mine-top {
  margin-top: 20rpx;
  position: relative;
  background-color: #FDF1EF;
  border-radius: 20rpx;
}

.mine-top::before,
.mine-top::after {
  content: '';
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #fff;
  position: absolute;
  left: 62.5%;
}

.mine-top::before {
  top: -10rpx;
}

.mine-top::after {
  bottom: -10rpx;
}

.top-img {
  width: 174rpx;
  height: 202rpx;
  position: absolute;
  right: 0rpx;
  bottom: 10rpx;
}

.top-left {
  width: 64%;
  border-right: 1px dashed #EACDC9;
}

.title-img {
  width: 200rpx;
  height: 64rpx;
  margin-left: 17%;
  margin-top: 20rpx;
}

.info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 20rpx;
  color: #666;
  padding: 30rpx 30rpx 50rpx 100rpx;
}

.info .label {
  font-size: 26rpx;
  font-weight: 500;
  color: #676767;
}

.top-bottom {
  font-size: 28rpx;
  color: #D77E8F;
  padding: 20rpx;
  text-align: center;
  border-radius: 20rpx;
  margin: 20rpx auto;
}

/* 用户名片卡片 */
.user-profile-card {
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 30rpx;
  border: 1px solid #FFE4E8;
  box-shadow: 0 8rpx 20rpx rgba(255, 133, 161, 0.05);
  position: relative;
  transition: all 0.2s ease;
}

.user-profile-card:active {
  transform: scale(0.99);
  opacity: 0.95;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(215, 126, 143, 0.15);
  margin-right: 24rpx;
}

.user-info-area {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.user-nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.user-tag-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-status-tag {
  font-size: 20rpx;
  color: #FF85A1;
  background: rgba(255, 133, 161, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.user-click-tip {
  font-size: 20rpx;
  color: #A0A0A0;
}

.arrow-right-icon {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #D77E8F;
  border-right: 3rpx solid #D77E8F;
  transform: rotate(45deg);
  margin-right: 10rpx;
}