.mine-container {
  padding: 30rpx;
  box-sizing: border-box;
  height: 100vh;
  background-color: #fff;
}

.mine-top {
  margin-top: 20rpx;
  position: relative;
  background-color: #FDF1EF;
  border-radius: 20rpx;
}

.mine-top::before,
.mine-top::after {
  content: '';
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #fff;
  position: absolute;
  left: 62.5%;
}

.mine-top::before {
  top: -10rpx;
}

.mine-top::after {
  bottom: -10rpx;
}

.top-img {
  width: 174rpx;
  height: 202rpx;
  position: absolute;
  right: 0rpx;
  bottom: 10rpx;
}

.top-left {
  width: 64%;
  border-right: 1px dashed #EACDC9;
}

.title-img {
  width: 200rpx;
  height: 64rpx;
  margin-left: 17%;
  margin-top: 20rpx;
}

.info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 20rpx;
  color: #666;
  padding: 30rpx 30rpx 50rpx 100rpx;
}

.info .label {
  font-size: 26rpx;
  font-weight: 500;
  color: #676767;
}

.top-bottom {
  font-size: 28rpx;
  color: #D77E8F;
  padding: 20rpx;
  text-align: center;
  border-radius: 20rpx;
  border: 1px solid #EACDC9;
  margin: 20rpx auto;
}