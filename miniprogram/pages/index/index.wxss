.page-container {
  padding: 0 32rpx;
  padding-bottom: 40rpx;
}

/* Splash Page */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #999;
  font-size: 28rpx;
}

.splash-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100vh;
  background: #fff;
  padding: 100rpx 40rpx;
  box-sizing: border-box;
}

.splash-header {
  margin-top: 100rpx;
  margin-bottom: 120rpx;
  text-align: center;
}

.splash-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #111;
  display: block;
  margin-bottom: 24rpx;
}

.splash-subtitle {
  font-size: 32rpx;
  color: #999;
}

.splash-features {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding-left: 80rpx;
  box-sizing: border-box;
}

.feature-item {
  display: flex;
  align-items: center;
  margin-bottom: 60rpx;
}

.feature-icon {
  width: 96rpx;
  height: 96rpx;
  margin-right: 40rpx;
}

.feature-text {
  font-size: 32rpx;
  color: #333;
}

.splash-footer {
  margin-top: auto;
  margin-bottom: 60rpx;
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.btn-start {
  background: #F48FB1;
  color: #fff;
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  border-radius: 48rpx;
  padding: 28rpx 0;
  width: 100%;
  box-shadow: 0 8rpx 24rpx rgba(244, 143, 177, 0.3);
}

/* Header */
.custom-header {
  display: flex;
  align-items: center;
  box-sizing: content-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 0 32rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.header-avatars {
  margin-top: 10rpx;
  display: flex;
  position: relative;
}

.avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
}

.avatar-2 {
  margin-left: -12rpx;
}

/* Common Card */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.02);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.icon-wrap {
  width: 48rpx;
  height: 48rpx;
  background: #FFF0F4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.icon image {
  width: 48rpx;
  height: 48rpx;
}

.card-title {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  padding-right: 20rpx;
}

/* Budget Card */
.budget-content-new {
  width: 100%;
  padding: 40rpx 0 20rpx 0;
  /* 为上方和下方的气泡留出空间 */
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.progress-bar-wrap {
  position: relative;
  width: 100%;
}

.bubble {
  position: absolute;
  transform: translateX(-50%);
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  z-index: 10;
  font-weight: 500;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.bubble.show {
  opacity: 1;
}

.bubble-top {
  bottom: 100%;
  margin-bottom: 12rpx;
  background: #ff7eb2;
  color: #fff;
  box-shadow: 0 4rpx 8rpx rgba(255, 133, 161, 0.4);
}

.bubble-bottom {
  top: 50%;
  background: #bfd7fb;
  color: #fff;
  box-shadow: 0 4rpx 8rpx rgba(131, 165, 198, 0.4);
}

.bubble-arrow-down {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  border-width: 8rpx 8rpx 0;
  border-style: solid;
  border-color: #FF85A1 transparent transparent transparent;
}

.bubble-arrow-up {
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  border-width: 0 8rpx 8rpx;
  border-style: solid;
  border-color: transparent transparent #bfd7fb transparent;
}

.progress-bar-bg {
  height: 24rpx;
  background: #FFF0F4;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  position: relative;
}

.progress-bar-fill-spent {
  height: 100%;
  background: #bfd7fb;
  border-radius: 12rpx;
  position: absolute;
  top: 0;
  left: 0;
  transition: width 0.8s ease-out;
}

.progress-bar-fill-paid {
  height: 100%;
  background: #ff7eb2;
  border-radius: 12rpx;
  position: absolute;
  top: 0;
  left: 0;
  transition: width 0.8s ease-out;
}

.progress-labels {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #999;
}

.divider {
  height: 2rpx;
  background: #F5F5F5;
  margin: 24rpx 0;
}

.budget-footer {
  font-size: 26rpx;
  color: #666;
}

.highlight {
  color: #FF85A1;
}

/* Countdown Card */
.countdown-card {
  display: flex;
  justify-content: space-between;
}

.countdown-info {
  flex: 1;
}

.countdown-days {
  margin-bottom: 8rpx;
}

.days-num {
  font-size: 80rpx;
  color: #FF85A1;
  font-weight: bold;
  line-height: 1;
}

.days-unit {
  font-size: 28rpx;
  color: #333;
  margin-left: 8rpx;
  font-weight: 500;
}

.countdown-label {
  font-size: 24rpx;
  color: #999;
}

.countdown-img-wrap {
  width: 230rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calendar-img-placeholder {
  width: 230rpx;
  height: 180rpx;
}

.calendar-img-placeholder image {
  width: 100%;
  height: 100%;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-icon {
  margin-right: 12rpx;
  width: 48rpx;
  height: 48rpx;
}

.btn-primary {
  border: 1px solid #FF85A1;
  color: #FF85A1;
  margin-right: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 133, 161, 0.3);
}

.btn-secondary {
  border: 1px solid #FF9EAB;
  color: #FF9EAB;
  box-shadow: 0 8rpx 20rpx rgba(255, 158, 171, 0.3);
}

/* Recent Section */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #FF85A1;
}

.expense-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 0 32rpx;
}

.expense-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.expense-item:last-child {
  border-bottom: none;
}

.item-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #FFF0F4;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.bg-blue {
  background: #F0F6FF;
}

.bg-yellow {
  background: #FFF8E5;
}

.item-icon {
  font-size: 40rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.item-desc {
  font-size: 22rpx;
  color: #999;
}

.item-amount {
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.item-arrow {
  font-size: 24rpx;
  color: #CCC;
}

/* 协作邀请头像与弹窗 */
.avatar-invite {
  background-color: #FFF0F2;
  border: 4rpx dashed #FF85A1 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.invite-plus {
  color: #FF85A1;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
}

/* 邀请模态浮层 */
.invite-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  backdrop-filter: blur(8px);
}

.invite-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 60rpx 40rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  box-shadow: 0 -10rpx 40rpx rgba(215, 126, 143, 0.15);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

.invite-modal-decor {
  font-size: 24rpx;
  color: #FF85A1;
  font-weight: 600;
  margin-bottom: 20rpx;
  background: #FFF0F2;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  letter-spacing: 2rpx;
}

.invite-modal-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.invite-modal-desc {
  font-size: 26rpx;
  color: #777777;
  line-height: 40rpx;
  text-align: center;
  margin-bottom: 50rpx;
  padding: 0 20rpx;
}

.invite-share-btn {
  width: 100% !important;
  height: 100rpx;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #FF94B0 0%, #FF6B8B 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 139, 0.35);
  margin-bottom: 30rpx;
  border: none;
  padding: 0;
  line-height: normal;
}

.invite-share-btn::after {
  border: none;
}

.invite-share-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.invite-modal-close {
  font-size: 26rpx;
  color: #999999;
  padding: 20rpx;
}