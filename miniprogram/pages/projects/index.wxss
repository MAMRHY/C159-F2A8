.page-container {
  padding: 0;
  padding-bottom: 40rpx;
}

/* Header */
.custom-header {
  display: flex;
  align-items: center;
  box-sizing: content-box;
  padding: 0 32rpx;
  background: #fff;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  display: flex;
  align-items: center;
  color: #FF85A1;
  font-size: 28rpx;
  font-weight: 500;
  background: #FFF0F4;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.add-icon {
  margin-right: 4rpx;
  font-size: 30rpx;
}

/* Tabs */
.tabs-scroll {
  width: 100%;
  background: #fff;
  padding-bottom: 20rpx;
  white-space: nowrap;
}

.tabs {
  display: flex;
  padding: 0 32rpx;
  padding-top: 20rpx;
}

.tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  background: #F6F6F6;
  color: #666;
  font-size: 28rpx;
  border-radius: 30rpx;
  margin-right: 20rpx;
}

.tab.active {
  background: #FFF0F4;
  color: #FF85A1;
  font-weight: 500;
}

/* Project List */
.project-list {
  padding: 32rpx;
}

.project-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.02);
}

.project-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.project-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.project-leader {
  font-size: 24rpx;
  color: #999;
}

.project-amount-status {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-right: 20rpx;
}

.amount-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-bottom: 12rpx;
}

.amount-label {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.amount-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status-pill {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-paid {
  background: #FFF0F4;
  color: #FF85A1;
}

.status-partial {
  background: #FFF6EC;
  color: #FFB067;
}

.status-unpaid {
  background: #F6F6F6;
  color: #999;
}

.item-arrow {
  font-size: 28rpx;
  color: #CCC;
}
