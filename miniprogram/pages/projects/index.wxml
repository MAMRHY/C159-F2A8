<view class="page-container">
  <!-- Custom Navigation Header -->
  <view class="custom-header" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="header-content" style="margin-right: {{windowWidth - capsuleLeft + 10}}px;">
      <text class="header-title">项目管理</text>
      <view class="add-btn" bindtap="goToAddProject">
        <text class="add-icon">＋</text>
        <text>新增项目</text>
      </view>
    </view>
  </view>
  <!-- Tabs -->
  <scroll-view class="tabs-scroll" scroll-x="true" show-scrollbar="false">
    <view class="tabs">
      <view class="tab {{activeTab === 0 ? 'active' : ''}}" bindtap="onTabChange" data-tab="0">
        全部
      </view>
      <view class="tab {{activeTab === 1 ? 'active' : ''}}" bindtap="onTabChange" data-tab="1">
        全部付清
      </view>
      <view class="tab {{activeTab === 2 ? 'active' : ''}}" bindtap="onTabChange" data-tab="2">
        部分付清
      </view>
      <view class="tab {{activeTab === 3 ? 'active' : ''}}" bindtap="onTabChange" data-tab="3">
        未开始付款
      </view>
    </view>
  </scroll-view>
  <!-- Project List -->
  <view class="project-list">
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{projects.length === 0}}">
      <text class="empty-icon">📂</text>
      <text class="empty-text">暂无项目</text>
      <text class="empty-sub">快去添加吧</text>
    </view>
    <!-- 动态项目列表 -->
    <view wx:for="{{projects}}" wx:key="_id" class="project-card" bindlongpress="onDeleteProject" data-id="{{item._id}}">
      <view class="project-info" bindtap="goToEditProject" data-id="{{item._id}}">
        <text class="project-name">{{item.name}}</text>
        <text class="project-leader">负责人：{{item.leader}}</text>
      </view>
      <view class="project-amount-status">
        <view class="amount-wrap">
          <text class="amount-label">总金额</text>
          <view class="amount-value {{item.totalAmount === '待定' ? 'pending' : ''}}">
            {{item.totalAmount === '待定' ? '待定' : '¥' + item.totalAmount}}
          </view>
        </view>
        <view class="status-pill {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <l-icon name="right" size="20" color="#666"></l-icon>
    </view>
  </view>
  <!-- 删除确认弹窗 -->
  <l-dialog show="{{showDeleteDialog}}" type="confirm" title="确认删除" content="确认删除吗？删除后该项目下的费用都将一并删除。" confirmText="确认" cancelText="取消" confirmColor="#FF4D4F" bind:linconfirm="onConfirmDelete" bind:lincancel="onCancelDelete" />
</view>