<view class="page-container">
  <!-- Card 1: Form -->
  <view class="form-card">
    <view class="form-item">
      <view class="item-left">
        <view class="icon-wrap pink">
          <text>💼</text>
        </view>
        <text class="label">关联项目</text>
      </view>
      <view class="item-right">
        <text class="placeholder">请选择关联项目</text>
        <text class="arrow">></text>
      </view>
    </view>
    
    <view class="form-divider"></view>

    <view class="form-item">
      <view class="item-left">
        <view class="icon-wrap orange">
          <text>🏷️</text>
        </view>
        <text class="label">费用类型</text>
      </view>
      <view class="item-right">
        <text class="placeholder">请选择费用类型</text>
        <text class="arrow">></text>
      </view>
    </view>

    <view class="form-divider"></view>

    <view class="form-item">
      <view class="item-left">
        <view class="icon-wrap blue">
          <text>¥</text>
        </view>
        <text class="label">金额</text>
      </view>
      <view class="item-right">
        <text class="amount-symbol">¥</text>
        <input class="amount-input" type="digit" placeholder="0.00" placeholder-class="amount-placeholder" />
      </view>
    </view>

    <view class="form-divider"></view>

    <view class="form-item">
      <view class="item-left">
        <view class="icon-wrap green">
          <text>💳</text>
        </view>
        <text class="label">支付状态</text>
      </view>
      <view class="item-right">
        <text class="status-text">未支付</text>
        <switch color="#E88B9E" style="transform:scale(0.8); margin-right:-10px;"></switch>
      </view>
    </view>
  </view>

  <!-- Card 2: More Details -->
  <view class="detail-card">
    <text class="detail-title">更多详情</text>
    <text class="arrow down">v</text>
  </view>

  <!-- Card 3: Photo / Voucher -->
  <view class="photo-card">
    <text class="photo-title">凭证 / 照片</text>
    <view class="upload-area">
      <view class="upload-icon-wrap">
        <text style="color:#E88B9E;font-size:36rpx;">📷</text>
      </view>
      <text class="upload-text">上传凭证或照片</text>
      <text class="upload-subtext">支持 JPG、PNG 格式，单张不超过 10MB</text>
    </view>
  </view>

  <!-- Footer -->
  <view class="footer">
    <view class="submit-btn">保存</view>
    <view class="safe-tip">
      <text class="lock-icon">🔒</text>
      <text>数据仅自己可见，安全放心</text>
    </view>
  </view>
</view>
