<view class="page-container">
  <!-- Card 1: Form -->
  <view class="form-card">
    <l-list title="💼 关联项目" right-desc="请选择关联项目" is-link="{{true}}" l-class="l-list-no-border"></l-list>
    <l-list title="🏷️ 费用类型" right-desc="请选择费用类型" is-link="{{true}}" l-class="l-list-no-border"></l-list>
    <l-list title="💰 金额" is-link="{{false}}" l-class="l-list-no-border">
      <view slot="right-section" class="item-right">
        <text class="amount-symbol">¥</text>
        <input class="amount-input" type="digit" placeholder="0.00" placeholder-class="amount-placeholder"></input>
      </view>
    </l-list>
    <l-list title="💳 支付状态" is-link="{{false}}" l-class="l-list-no-border">
      <view slot="right-section" class="item-right">
        <text class="status-text">未支付</text>
        <switch color="#E88B9E" style="transform:scale(0.8); margin-right:-10px;"></switch>
      </view>
    </l-list>
  </view>
  <!-- Card 2: More Details -->
  <view class="detail-card" bindtap="toggleMoreDetails">
    <view class="detail-top">
      <text class="detail-title">更多详情</text>
      <l-icon name="{{showMore ? 'up' : 'down'}}" size="28" color="#ccc"></l-icon>
    </view>
    <!-- More Details Expanded -->
    <view class="form-card" wx:if="{{showMore}}">
      <l-list title="支付方式" is-link="{{true}}" l-class="l-list-no-border">
        <view slot="right-section" class="item-right">
          <picker mode="selector" range="{{paymentOptions}}" bindchange="onPaymentMethodChange">
            <view class="placeholder" style="{{paymentMethod ? 'color:#333;' : ''}}">
              {{paymentMethod ? paymentMethod : '请选择支付方式'}}
            </view>
          </picker>
        </view>
      </l-list>
      <l-list title="支付时间" is-link="{{true}}" l-class="l-list-no-border">
        <view slot="right-section" class="item-right">
          <picker mode="date" bindchange="onDateChange">
            <view class="placeholder" style="{{paymentDate ? 'color:#333;' : ''}}">
              {{paymentDate ? paymentDate : '请选择支付时间'}}
            </view>
          </picker>
        </view>
      </l-list>
    </view>
  </view>
  <!-- Card 3: Photo / Voucher -->
  <view class="photo-card">
    <l-image-picker size="5" bind:linchange="onChangeTap">
      <text class="photo-title">凭证 / 照片</text>
      <view class="upload-area">
        <view class="upload-icon-wrap">
          <text style="color:#E88B9E;font-size:36rpx;">📷</text>
        </view>
        <text class="upload-text">上传凭证或照片</text>
        <text class="upload-subtext">支持 JPG、PNG 格式，单张不超过 10MB</text>
      </view>
    </l-image-picker>
  </view>
  <!-- Footer -->
  <view class="footer">
    <l-button bg-color="#E88B9E" shape="circle" l-class="submit-btn-l" size="long">保存</l-button>
  </view>
</view>