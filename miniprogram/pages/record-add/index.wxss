.page-container {
  min-height: 100vh;
  background-color: #FCF8F9;
  padding: 30rpx;
  box-sizing: border-box;
}

.l-list-no-border {
  border-bottom: none !important;
}

/* Card 1: Form */
.form-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 10rpx 30rpx;
  margin-bottom: 30rpx;
}

.item-right {
  display: flex;
  align-items: center;
}

.amount-symbol {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}

.amount-input {
  text-align: right;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  width: 200rpx;
}

.amount-placeholder {
  color: #333;
}

.status-text {
  font-size: 28rpx;
  color: #999;
  margin-right: 10rpx;
}

/* Card 2: Detail */
.detail-card {
  background-color: #fff;
  border-radius: 24rpx;
}

.detail-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.detail-title {
  font-size: 28rpx;
  color: #333;
}

/* Card 3: Photo */
.photo-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 30rpx auto 60rpx;
}

.photo-title {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
}

.upload-area {
  border: 1px dashed #F0D0D6;
  border-radius: 16rpx;
  background-color: #FEF9FA;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.upload-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background-color: #FDF1EF;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.upload-subtext {
  font-size: 22rpx;
  color: #CCC;
}

/* Footer */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* .submit-btn-l {
  width: 100% !important;
  margin-bottom: 30rpx;
} */

.safe-tip {
  font-size: 22rpx;
  color: #999;
  display: flex;
  align-items: center;
}

.lock-icon {
  margin-right: 8rpx;
}