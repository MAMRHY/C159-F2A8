.page-container {
  min-height: 100vh;
  background-color: #FCF8F9;
  padding: 30rpx;
  box-sizing: border-box;
}

.l-list-no-border {
  border-bottom: none !important;
}

/* Card 1: Form */
.form-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 10rpx 30rpx;
  margin-bottom: 30rpx;
}

.item-right {
  display: flex;
  align-items: center;
}

.amount-symbol {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}

.amount-input {
  text-align: right;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  width: 200rpx;
}

.amount-placeholder {
  color: #333;
}

.status-text {
  font-size: 28rpx;
  color: #999;
  margin-right: 10rpx;
}

/* Card 2: Detail */
.detail-card {
  background-color: #fff;
  border-radius: 24rpx;
}

.detail-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.detail-title {
  font-size: 28rpx;
  color: #333;
}

/* Type Picker Modal */
.type-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.type-picker-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 16px 16px 0 0;
  z-index: 1001;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.type-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #eee;
}

.type-picker-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.type-picker-close {
  font-size: 20px;
  color: #999;
  padding: 5px;
  line-height: 1;
}

.type-search-bar {
  padding: 12px 20px;
  display: flex;
  align-items: center;
  border-bottom: 1px solid #eee;
}

.type-search-input {
  flex: 1;
  background: #f5f5f5;
  height: 36px;
  border-radius: 18px;
  padding: 0 16px;
  font-size: 14px;
}

.type-add-btn {
  margin-left: 12px;
  color: #FF85A1;
  font-size: 14px;
  font-weight: 500;
  padding: 6px 10px;
  background: rgba(255, 133, 161, 0.1);
  border-radius: 4px;
}

.type-list {
  flex: 1;
  min-height: 200px;
  max-height: 40vh;
}

.type-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #f9f9f9;
  font-size: 15px;
  color: #333;
}

.type-item.active {
  color: #FF85A1;
}

.check-icon {
  color: #FF85A1;
  font-weight: bold;
}

.type-empty {
  text-align: center;
  color: #999;
  font-size: 14px;
  padding: 40px 0;
}

/* Card 3: Photo */
.photo-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 30rpx auto 60rpx;
}

.photo-title {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
}

.upload-area {
  border: 1px dashed #F0D0D6;
  border-radius: 16rpx;
  background-color: #FEF9FA;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.upload-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background-color: #FDF1EF;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.upload-subtext {
  font-size: 22rpx;
  color: #CCC;
}

/* Footer */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.submit-btn-l {
  width: 100% !important;
  margin-bottom: 0;
}

.safe-tip {
  font-size: 22rpx;
  color: #999;
  display: flex;
  align-items: center;
}

.lock-icon {
  margin-right: 8rpx;
}